NODE_ENV       =   # production
PORT           =   # Health-check server port
BOT_TOKEN      =   # Telegram bot token from @BotFather
DATABASE_URL   =   # Postgres connection string
TIMEZONE       =   # e.g. Asia/Singapore, used for poll dates and vote cutoffs
WEBHOOK_URL    =   # Optional: public https URL Telegram posts updates to (e.g. https://<host>/telegram); leave blank for long polling
WEBHOOK_SECRET =   # Optional: random string Telegram sends back so only it can call the webhook
